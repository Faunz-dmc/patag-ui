# Connection references only; no current application reads these variables.
# Root .env.local is for public metadata only. Keep both web VITE_API_URL values unchanged.
SUPABASE_PROJECT_REF=<existing-project-reference>
SUPABASE_URL=https://<existing-project-reference>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<existing-publishable-key>

# Existing PostgreSQL session pooler metadata; no password or authenticated URI here.
SUPABASE_DB_HOST=<existing-session-pooler-host>
SUPABASE_DB_PORT=<existing-session-pooler-port>
SUPABASE_DB_NAME=<existing-database-name>
SUPABASE_DB_USER=<existing-session-pooler-user>

# Future backend secret store only. Do not copy this variable into root .env.local.
# No existing server-side environment file or configured secret manager was found.
# SUPABASE_DB_PASSWORD=<configure-privately-in-the-backend-secret-store>
