# Public connection metadata explicitly loaded by backend commands.
# Root .env.local is public metadata only; real admin defaults to same-site /api.
SUPABASE_PROJECT_REF=<existing-project-reference>
SUPABASE_URL=https://<existing-project-reference>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<existing-publishable-key>

# Existing PostgreSQL session pooler metadata; no password or authenticated URI here.
SUPABASE_DB_HOST=<existing-session-pooler-host>
SUPABASE_DB_PORT=<existing-session-pooler-port>
SUPABASE_DB_NAME=<existing-database-name>
SUPABASE_DB_USER=<existing-session-pooler-user>

# Private credentials belong only in backend/.env.local or server environment.
# Use SUPABASE_DB_URL in the backend private environment; no standalone password is loaded.
# SUPABASE_DB_PASSWORD=<configure-privately-in-the-backend-secret-store>

# Runtime note, 27 October 2026: backend commands now explicitly load this public
# metadata, then backend/.env.local for private server values. See docs/supabase-backend.md.
# Keep service-role keys, database URIs/passwords and the seed password out of this file.
