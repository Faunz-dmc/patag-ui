# PRIVATE SERVER SETTINGS: copy this file to backend/.env.local, never into admin-web.
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY may remain in root .env.local.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
ADMIN_ORIGIN=http://127.0.0.1:5173
PORT=4101
# Enable only when a controlled reverse proxy overwrites one X-Forwarded-For value.
TRUST_PROXY_CLIENT_IP=false
# Optional CA trust is configured via NODE_EXTRA_CA_CERTS; never disable TLS validation.
# Set only after authorizing hosted migrations/bootstrap for the configured project.
PATAG_ALLOW_HOSTED_MUTATIONS=false
PATAG_TEST_ADMIN_PASSWORD=
