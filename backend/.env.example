# Copy to backend/.env (git-ignored) and fill in. Never commit .env or put these in
# Flutter --dart-define, VITE_* variables or the root .env.local.

# --- Server
PORT=4100
# 127.0.0.1 = this PC only (Android emulator reaches it via 10.0.2.2; USB phones via `npm run mobile:usb`).
# For phones on your Wi-Fi run `npm run api:lan` instead of changing this (it listens on 0.0.0.0).
HOST=127.0.0.1
# Passwordless demo authentication has been removed; no flag can enable it.
# Behind a hosting load balancer (Render, Railway…): number of trusted proxy hops, e.g. 1. Leave unset locally.
# TRUST_PROXY=
# Browsers allowed to call the API. For `flutter run -d chrome` (random port) add, on your PC only:
#   http://localhost:*,http://127.0.0.1:*
# The ":*" wildcard works only for localhost/127.0.0.1. Never allow "*".
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174

# --- Supabase project (see docs/supabase-connection.md)
SUPABASE_URL=https://fzivdpjaceoegetsnbta.supabase.co
# Supabase dashboard > Project Settings > API Keys > Secret key (sb_secret_...). SECRET.
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=report-photos

# --- Address autofill for the report form's map pin (optional)
# Mapbox account > Tokens (https://account.mapbox.com/access-tokens/). Server-side only:
# never put it in the Flutter apps. Without it, address autofill is simply off.
MAPBOX_TOKEN=

# --- Postgres via the Supabase session pooler
SUPABASE_DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.fzivdpjaceoegetsnbta
# Supabase dashboard > Database > Settings > Database password. SECRET.
SUPABASE_DB_PASSWORD=
# Supabase CA certificate (Dashboard > Database > Settings > SSL > Download certificate) so the
# server's identity is verified. Either a file path, or the PEM text itself (useful on hosting env vars).
# SUPABASE_DB_CA_CERT=./prod-ca-2021.crt
# Alternative to the SUPABASE_DB_* values above:
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Only for `npm run create-admin`
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
